# ── Aplicação ──
NODE_ENV=development
PORT=3000

# ── Banco de Dados (PostgreSQL) ──
DATABASE_URL=postgresql://coleira:coleira@localhost:5433/coleira?schema=public

# ── Cache (Redis) ──
REDIS_URL=redis://localhost:6379

# ── Auth (JWT) ──
JWT_ACCESS_SECRET=change-me-access-secret-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-dev-only
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ── Código de ativação (AES-256-GCM, 32 bytes hex) ──
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACTIVATION_CODE_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Privacidade (hash de IP do visitante — obrigatório, sem fallback) ──
IP_HASH_SALT=change-me-ip-hash-salt-32-caracteres-minimo

# ── CORS (origens permitidas, separadas por vírgula) ──
# Deixar vazio = sem CORS (same-origin apenas)
CORS_ORIGINS=http://localhost:5173

# ── Logging ──
LOG_LEVEL=debug

# ── Mercado Pago (webhook HMAC) ──
MERCADO_PAGO_WEBHOOK_SECRET=change-me-webhook-secret-dev-only

# ── Seed (senhas dos usuários padrão — obrigatórias; NUNCA default em código) ──
SUPER_ADMIN_PASSWORD=change-me-super-admin-password
ADMIN_PASSWORD=change-me-admin-password
# Cliente de demonstração (role USER) com 2 pets e assinatura Premium
SYSTEM_USER_PASSWORD=change-me-system-user-password
